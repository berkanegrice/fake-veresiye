# /etc/systemd/system/fakeveresiye-backup.service
# Runs one backup. Triggered by fakeveresiye-backup.timer.

[Unit]
Description=FakeVeresiye database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# --- edit these ---------------------------------------------------------------
# Absolute path to the bind-mounted database (compose.yaml maps ./data -> /data).
Environment=FV_DB=/opt/fakeveresiye/data/fakeveresiye.db
Environment=FV_BACKUP_DIR=/var/backups/fakeveresiye
Environment=FV_KEEP=14
# age public key that backups are encrypted to (keep the PRIVATE key off this box).
Environment=FV_AGE_RECIPIENT=age1REPLACE_WITH_YOUR_PUBLIC_KEY
# Email address for the offsite copy (needs msmtp configured for the User below).
Environment=FV_MAIL_TO=owner@example.com
# Optional healthchecks.io (or similar) URL, pinged on success.
Environment=FV_HEALTHCHECK_URL=
# ---------------------------------------------------------------------------

ExecStart=/opt/fakeveresiye/deploy/backup.sh

# root can read the container-owned DB file (uid 1654) and write /var/backups.
User=root
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/fakeveresiye
NoNewPrivileges=true
