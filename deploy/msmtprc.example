# msmtp config for sending the backup email.
# Copy to /root/.msmtprc (the backup service runs as root), then: chmod 600 /root/.msmtprc
#
# Gmail: enable 2-Step Verification, then create an "App password" and use it below —
# NOT your account password. https://myaccount.google.com/apppasswords

defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /var/log/msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           you@gmail.com
user           you@gmail.com
password       xxxxxxxxxxxxxxxx        # 16-char Gmail App password

account default : gmail

# Prefer a transactional provider for reliability (Brevo, Postmark, Resend-SMTP, SES).
# Same block, different host/port/user/password.
